{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile database information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique user ID from Firebase Auth" },
        "email": { "type": "string", "format": "email", "description": "The user email" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "description": "User's avatar profile URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["uid", "email"]
    },
    "UserState": {
      "title": "UserState",
      "description": "User's active quiz and sandbox index state on the platform",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User identifier" },
        "currentLanguage": { "type": "string", "description": "The technology currently selected, e.g. React" },
        "currentDifficulty": { "type": "string", "description": "The level currently selected, e.g. Easy" },
        "currentSubBabIndex": { "type": "integer", "description": "Index of current active sub-chapter or task they are on" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp when state was modified last" }
      },
      "required": ["userId", "currentLanguage", "currentDifficulty", "currentSubBabIndex"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles collections"
    },
    "/user_states/{userId}": {
      "schema": "UserState",
      "description": "User tracking and quiz/sandbox statuses"
    }
  }
}
